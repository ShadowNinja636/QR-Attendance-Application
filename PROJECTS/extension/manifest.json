{
  "manifest_version": 3,
  "name": "AI Accessibility Assistant",
  "version": "1.0",
  "description": "Voice + AI-based accessibility for visually impaired users",
  "permissions": [
    "scripting",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
  "<all_urls>",
  "https://generativelanguage.googleapis.com/*"
],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}